# Copy to database/.env and paste your own Neon branch connection string.
# Used by `alembic upgrade head` in database/core and by seed/seed_concepts.py.
# Migrations and seeding use the DIRECT (unpooled) endpoint. The pooled endpoint
# is for application traffic, not DDL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
