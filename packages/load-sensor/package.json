{
  "name": "@adaptlearn/load-sensor",
  "version": "0.0.0",
  "private": true,
  "description": "C02 cognitive load detection: privacy-first, in-browser webcam load sensor for AdaptLearn.",
  "type": "module",
  "exports": {
    ".": "./src/core/index.ts",
    "./signals": "./src/signals.ts"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "tsx scripts/bench.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "fetch-models": "tsx scripts/fetch-models.ts",
    "feature-spec": "tsx scripts/feature-spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@mediapipe/face_detection": "0.4.1646425229",
    "@mediapipe/face_mesh": "0.4.1633559619",
    "@tensorflow-models/face-detection": "1.0.3",
    "@tensorflow-models/face-landmarks-detection": "1.0.6",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0"
  }
}
