{
  // Node-side TypeScript: unit and e2e tests, scripts, and tool configs.
  // Tests import browser code from src/, so the DOM lib is included here too.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["tests", "scripts", "*.config.ts"]
}
