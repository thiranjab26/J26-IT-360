# Copy to .env and fill in. Never commit .env.
#
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
# Migrations and the concept seeder use the direct endpoint, from database/.env.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

ENVIRONMENT=development
LOG_LEVEL=info

AUTH_PORT=8001
AUTH_DB_SCHEMA=core

# Must be byte-identical to the gateway's JWT_SECRET: this service signs the
# token and the gateway verifies it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-generate-a-real-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=adaptlearn-auth
AUTH_ACCESS_TOKEN_TTL_MINUTES=720
