# viva-service (C4) settings. Copy to .env in this folder and fill in. Never commit .env.
# Shared AdaptLearn names (no prefix): DATABASE_URL, ENVIRONMENT, LOG_LEVEL, INTEGRATION_MODE.
# Everything else is prefixed VIVA_.
ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Cross-component reads stay stubbed until the integration phase.
INTEGRATION_MODE=stub
VIVA_PORT=8401
VIVA_DB_SCHEMA=viva
# Prototype convenience: create the viva schema and tables at startup. The team process is
# `uv run alembic upgrade head`; set this to false once migrations are used.
VIVA_CREATE_TABLES_ON_STARTUP=true

# Local demo only. Copy to .env in this service folder. Never commit real keys.
VIVA_DEV_MODE=true
# Neon POOLED url (host contains -pooler); sqlite:///./viva.db works for offline demos.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon example: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
VIVA_ADMIN_ACCESS_KEYS=demo-admin-local
VIVA_EVALUATOR_ACCESS_KEYS=demo-evaluator-local,demo-evaluator-two-local
VIVA_TOKEN_HOURS=24
VIVA_SEED_DEMO_BANK=true
VIVA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# demo | ollama | openai. Ollama uses base host; OpenAI-compatible URL includes /v1.
VIVA_ASSESSMENT_PROVIDER=demo
VIVA_GENERATION_PROVIDER=demo
VIVA_LLM_BASE_URL=http://127.0.0.1:11434
VIVA_LLM_MODEL=qwen2.5:7b
VIVA_LLM_API_KEY=
VIVA_ALLOW_CLOUD_LLM=false
VIVA_DEMO_FALLBACK=false

# disabled | faster_whisper. Local STT; no cloud audio upload.
VIVA_SPEECH_PROVIDER=disabled
VIVA_WHISPER_MODEL=base.en
VIVA_WHISPER_DEVICE=cpu
VIVA_MAX_AUDIO_BYTES=20971520
VIVA_WHISPER_COMPUTE_TYPE=int8
VIVA_WHISPER_CPU_THREADS=4
VIVA_WHISPER_BEAM_SIZE=1
# Set empty to detect language; an English-only .en model still needs English speech.
VIVA_WHISPER_LANGUAGE=en
# Enable after downloading the chosen model to move loading time to startup.
VIVA_SPEECH_WARMUP=false

# Shared limits in the configured SQLite/Neon database. Daily windows use UTC.
VIVA_API_REQUESTS_PER_MINUTE=120
VIVA_AUTH_REQUESTS_PER_MINUTE=10
VIVA_LLM_REQUESTS_PER_MINUTE=15
VIVA_LLM_DAILY_CALLS=500
VIVA_LLM_USER_DAILY_CALLS=50
# Conservative request-byte + max-output reservation units, not provider billing tokens.
VIVA_LLM_DAILY_TOKEN_BUDGET=2000000
VIVA_LLM_MAX_OUTPUT_TOKENS=4096
VIVA_LLM_TIMEOUT_SECONDS=45
VIVA_SPEECH_DAILY_CALLS=1000
VIVA_SPEECH_USER_DAILY_CALLS=100
VIVA_MAX_MATERIAL_BYTES=5242880
VIVA_MAX_MATERIAL_CHARS=200000

# Keep an existing Gemini-compatible setup using these same LLM_* variables.
# VIVA_ASSESSMENT_PROVIDER=openai
# VIVA_GENERATION_PROVIDER=openai
# VIVA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VIVA_LLM_MODEL=<your currently enabled Gemini model>
# VIVA_LLM_API_KEY=<your Gemini API key, server-side only>
# VIVA_ALLOW_CLOUD_LLM=true

# Optional real teammate integrations. Empty means clearly labeled mock for that component.
# C01/C02: GET URL?topic_id=stacks&participant_id=<pseudonymous UUID>
# C03: POST URL {topic,courseId,studentId}; accepts camelCase or snake_case resources.
VIVA_C01_API_URL=
VIVA_C02_API_URL=
VIVA_C03_API_URL=
VIVA_INTEGRATION_API_TOKEN=
VIVA_INTEGRATION_TIMEOUT_SECONDS=10
# Optional review notification endpoint only; never an endpoint that edits mastery.
VIVA_C01_REVIEW_URL=

# Optional second OpenAI-compatible provider, tried when the primary returns 429/5xx/timeout or unusable output.
# VIVA_FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
# VIVA_FALLBACK_LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b  (comma-separated; tried in order)
# VIVA_FALLBACK_LLM_API_KEY=<server-side only>
# VIVA_FALLBACK_LLM_OUTPUT_MODE=json_schema
# LLM words each policy-selected follow-up from the student's answer and personalises the plan.
# Stored prompts/rule-based plan remain the audited fallback. Ignored when ASSESSMENT_PROVIDER=demo.
VIVA_LLM_FOLLOW_UP_PHRASING=true
