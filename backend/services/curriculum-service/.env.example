# Copy to .env and fill in. Never commit .env.
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# development | test | production. Production hides /docs and /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Reads of C2 load, C3 attempts and C4 review flags stay stubbed
# until those components publish their views.
INTEGRATION_MODE=stub

CURRICULUM_PORT=8101

# Migrations (alembic) change table structure, so they use the DIRECT endpoint:
# the same URL as DATABASE_URL without "-pooler". Falls back to DATABASE_URL.
CURRICULUM_MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neo4j holds the prerequisite graph. Optional: leave these empty and the
# service reads the graph from Postgres (core.concept_prerequisites) instead.
CURRICULUM_NEO4J_URI=
CURRICULUM_NEO4J_USER=
CURRICULUM_NEO4J_PASSWORD=

# GAT readiness model from research notebook 04 (not in git: copy gat-v2.npz and
# feature_spec.json from Drive junyi_processed/gat/ into models/). Relative paths
# are from this folder. Empty, missing or a checksum mismatch = rules-v1.
CURRICULUM_MODEL_PATH=models/gat-v2.npz
CURRICULUM_MODEL_SHA256=914a3046ac95daa2a58228de2ac6e75811c83f625760c826594123bf2c9cb17d

# How new learners get a study group. balanced = random among the least-filled
# cells (the study design, default). adaptive = demo mode (PP1): every new learner
# is adaptive; learners who already have a group keep it.
CURRICULUM_GROUP_ASSIGNMENT=balanced

# The mastery threshold (0.70) is fixed by the contracts, so it is not a setting.
