# Copy to .env and fill in. Never commit .env.
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# development | test | production. Production hides /docs and /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Reads of C2 load, C3 attempts and C4 review flags stay stubbed
# until those components publish their views.
INTEGRATION_MODE=stub

CURRICULUM_PORT=8101

# Migrations (alembic) change table structure, so they use the DIRECT endpoint:
# the same URL as DATABASE_URL without "-pooler". Falls back to DATABASE_URL.
CURRICULUM_MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neo4j holds the prerequisite graph. Optional: leave these empty and the
# service reads the graph from Postgres (core.concept_prerequisites) instead.
CURRICULUM_NEO4J_URI=
CURRICULUM_NEO4J_USER=
CURRICULUM_NEO4J_PASSWORD=

# Added by the step that first reads them, so every variable here has a reader:
#   mastery   CURRICULUM_MASTERY_THRESHOLD
#   model     CURRICULUM_MODEL_PATH, CURRICULUM_MODEL_SHA256
