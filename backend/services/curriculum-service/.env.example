# Copy to .env and fill in. Never commit .env.
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Keep stub until phase P7.
INTEGRATION_MODE=stub

CURRICULUM_PORT=8101
CURRICULUM_DB_SCHEMA=curriculum

# C1 only, not needed for the P0 catalogue:
# CURRICULUM_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# CURRICULUM_NEO4J_USER=neo4j
# CURRICULUM_NEO4J_PASSWORD=
