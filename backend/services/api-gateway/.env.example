# Copy to .env and fill in. Never commit .env.
GATEWAY_PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Must be byte-identical to auth-service's AUTH_JWT_SECRET: auth signs the
# token, the gateway verifies it.
JWT_SECRET=change-me-generate-a-real-secret
JWT_ISSUER=adaptlearn-auth

# Where each service listens. A service that is not running yields a clean 503.
AUTH_SERVICE_URL=http://localhost:8001
CURRICULUM_SERVICE_URL=http://localhost:8101
LOAD_SERVICE_URL=http://localhost:8201
TUTOR_SERVICE_URL=http://localhost:8301
VIVA_SERVICE_URL=http://localhost:8401
