# Copy to .env and fill in. Never commit .env.
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Cross-component reads (C1 mastery, C2 load) stay stubbed until P7.
INTEGRATION_MODE=stub

TUTOR_PORT=8301
TUTOR_DB_SCHEMA=tutor
TUTOR_CONTENT_DB_SCHEMA=content

# Added by the phase that first reads them, so every variable here has a reader:
#   P1  TUTOR_CHROMA_PATH, TUTOR_EMBEDDING_MODEL
#   P2  TUTOR_LLM_PROVIDER, TUTOR_OPENAI_API_KEY, TUTOR_GEMINI_API_KEY,
#       TUTOR_OLLAMA_BASE_URL, TUTOR_OLLAMA_MODEL
#   P3  TUTOR_NLI_MODEL, TUTOR_MAX_REGENERATION_ATTEMPTS, TUTOR_RETRIEVAL_CONDITION
#   P4  TUTOR_PISTON_URL
