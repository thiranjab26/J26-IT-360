# Copy to .env and fill in. Never commit .env.
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Cross-component reads (C1 mastery, C2 load) stay stubbed until P7.
INTEGRATION_MODE=stub

TUTOR_PORT=8301

# Direct (unpooled) Neon endpoint, used by Alembic and the content sync. Optional:
# falls back to DATABASE_URL, which also works but is the pooler.
TUTOR_MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Authored course material, relative to this service folder.
TUTOR_CONTENT_DIR=content

# Embedded vector store (gitignored) and the local embedding model. MiniLM reads 256
# tokens; `index` reports how many chunks are longer. Changing the model makes `index`
# build a second collection next to the first, so nothing is overwritten.
TUTOR_CHROMA_PATH=.chroma
TUTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Guided sessions. mastery_gated or points_only (the two study conditions).
# TUTOR_ENFORCE_UNLOCKS=false opens every concept, handy for demos.
TUTOR_SESSION_POLICY=mastery_gated
TUTOR_ENFORCE_UNLOCKS=true

# LLM providers. Gemini is the cloud provider, Ollama the offline fallback.
TUTOR_LLM_PROVIDER=gemini
# Create a key in Google AI Studio and paste it here. Never commit .env.
TUTOR_GEMINI_API_KEY=
# Check the current model names in Google AI Studio; change this if it has moved on.
TUTOR_GEMINI_MODEL=gemini-2.5-flash
TUTOR_OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5-coder:7b is the stronger fallback but slow on a CPU; qwen2.5:1.5b is quick
# and good enough to check the wiring, not to teach with.
TUTOR_OLLAMA_MODEL=qwen2.5-coder:7b

# Added by the phase that first reads them, so every variable here has a reader:
#   P3  TUTOR_NLI_MODEL, TUTOR_MAX_REGENERATION_ATTEMPTS, TUTOR_RETRIEVAL_CONDITION
#   P4  TUTOR_PISTON_URL
