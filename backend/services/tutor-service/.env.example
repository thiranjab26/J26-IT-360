# Copy to .env and fill in. Never commit .env.
# Application traffic uses the Neon POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

ENVIRONMENT=development
LOG_LEVEL=info
# stub | live. Cross-component reads (C1 mastery, C2 load) stay stubbed until P7.
INTEGRATION_MODE=stub

TUTOR_PORT=8301

# Direct (unpooled) Neon endpoint, used by Alembic and the content sync. Optional:
# falls back to DATABASE_URL, which also works but is the pooler.
TUTOR_MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Authored course material, relative to this service folder.
TUTOR_CONTENT_DIR=content

# Embedded vector store (gitignored) and the local embedding model. MiniLM reads 256
# tokens; `index` reports how many chunks are longer. Changing the model makes `index`
# build a second collection next to the first, so nothing is overwritten.
TUTOR_CHROMA_PATH=.chroma
TUTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Guided sessions. mastery_gated or points_only (the two study conditions).
# TUTOR_ENFORCE_UNLOCKS=false opens every concept, handy for demos.
# The local time zone that defines "a day" for streaks.
TUTOR_TIMEZONE=Asia/Colombo
TUTOR_SESSION_POLICY=mastery_gated
TUTOR_ENFORCE_UNLOCKS=true

# LLM providers. Gemini is the cloud provider, Ollama the offline fallback.
TUTOR_LLM_PROVIDER=gemini
# Create a key in Google AI Studio and paste it here. Never commit .env.
TUTOR_GEMINI_API_KEY=
# The shared cache of checked explanations is keyed on this exact model name, so keep it
# the same as the one the explanations were built with.
TUTOR_GEMINI_MODEL=gemini-3.5-flash-lite
TUTOR_OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5-coder:7b is the stronger fallback but slow on a CPU; qwen2.5:1.5b is quick
# and good enough to check the wiring, not to teach with.
TUTOR_OLLAMA_MODEL=qwen2.5-coder:7b

# Seconds to wait for a model before falling back to the authored course text.
TUTOR_LLM_TIMEOUT_SECONDS=15
# Optional second provider if the first fails: ollama, or leave empty for none.
TUTOR_LLM_FALLBACK_PROVIDER=

# Added by the phase that first reads them, so every variable here has a reader:
#   P3  TUTOR_NLI_MODEL, TUTOR_MAX_REGENERATION_ATTEMPTS, TUTOR_RETRIEVAL_CONDITION
#   P4  TUTOR_PISTON_URL

# Faithfulness gate: every generated text is checked against the course passage it came
# from before a student sees it. The threshold is a measured result (see
# research/c3-RAG tutor/README.md); do not change it without re-measuring.
TUTOR_GATE_ENABLED=true
TUTOR_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
TUTOR_GATE_THRESHOLD=0.77
# Also judge each claim against short stretches of the passage, not only the whole
# passage. Measured to lift supported-claim pass rate by 8 to 10 points at the same
# block rate; it makes each check slower, which is why explanations are prebuilt.
TUTOR_GATE_WINDOWS=true
# claim (judge each statement, the proposed method) or whole_response (the baseline).
TUTOR_GATE_GRANULARITY=claim
# llm (atomic claims written by the model) or sentences (rule-based splitting).
TUTOR_GATE_DECOMPOSER=llm
# Extra tries after a blocked text, each told which statements were unsupported.
TUTOR_GATE_MAX_REGENERATIONS=1
# Which kinds of text are checked: explain, reteach, hint.
TUTOR_GATE_KINDS=explain,reteach,hint
